NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_your_sandbox_client_side_token
NEXT_PUBLIC_PADDLE_STARTER_MONTHLY_PRICE_ID=pri_your_starter_monthly_price_id
NEXT_PUBLIC_PADDLE_STARTER_YEARLY_PRICE_ID=pri_your_starter_yearly_price_id
NEXT_PUBLIC_PADDLE_PRO_MONTHLY_PRICE_ID=pri_your_pro_monthly_price_id
NEXT_PUBLIC_PADDLE_PRO_YEARLY_PRICE_ID=pri_your_pro_yearly_price_id
NEXT_PUBLIC_PADDLE_ADVANCED_MONTHLY_PRICE_ID=pri_your_advanced_monthly_price_id
NEXT_PUBLIC_PADDLE_ADVANCED_YEARLY_PRICE_ID=pri_your_advanced_yearly_price_id

# Set this as a Firebase Functions secret, not as public browser configuration.
# Include every Cloudinary product environment used by wallpaper records.
CLOUDINARY_ACCOUNTS_JSON={"your_cloud_name":{"apiKey":"your_api_key","apiSecret":"your_api_secret"}}
