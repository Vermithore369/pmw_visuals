rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function hasPremiumClaim() {
      return signedIn()
        && (
          request.auth.token.premium == true
          || request.auth.token.role == 'premium'
          || request.auth.token.plan in ['creative', 'premium', 'business', 'starter', 'pro', 'advanced', 'advance', 'elite']
        );
    }

    function hasPremiumAccountDoc() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.premium == true
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'premium'
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.plan in ['creative', 'premium', 'business', 'starter', 'pro', 'advanced', 'advance', 'elite']
        );
    }

    function isPremium() {
      return hasPremiumClaim() || hasPremiumAccountDoc();
    }

    function isValidDeviceTypes() {
      return request.resource.data.deviceTypes is list
        && request.resource.data.deviceTypes.size() > 0
        && request.resource.data.deviceTypes.size() <= 2
        && request.resource.data.deviceTypes[0] in ['mobile', 'desktop']
        && (
          request.resource.data.deviceTypes.size() == 1
          || request.resource.data.deviceTypes[1] in ['mobile', 'desktop']
        );
    }

    function canReadWallpaper() {
      return isAdmin()
        || resource.data.visible == true;
    }

    function isValidWallpaper() {
      return request.resource.data.keys().hasOnly([
          'title',
          'description',
          'imageUrl',
          'previewUrl',
          'cloudinaryPublicId',
          'cloudinaryCloudName',
          'deliveryType',
          'resourceType',
          'types',
          'deviceTypes',
          'hashtags',
          'access',
          'visible',
          'width',
          'height',
          'format',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.description is string
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() > 0
        && request.resource.data.imageUrl.matches('https://res\\.cloudinary\\.com/.*')
        && (
          !request.resource.data.keys().hasAny(['previewUrl'])
          || (
            request.resource.data.previewUrl is string
            && request.resource.data.previewUrl.matches('https://res\\.cloudinary\\.com/.*')
          )
        )
        && request.resource.data.cloudinaryPublicId is string
        && (
          !request.resource.data.keys().hasAny(['cloudinaryCloudName'])
          || request.resource.data.cloudinaryCloudName is string
        )
        && (
          !request.resource.data.keys().hasAny(['deliveryType'])
          || request.resource.data.deliveryType in ['upload', 'private', 'authenticated']
        )
        && (
          !request.resource.data.keys().hasAny(['resourceType'])
          || request.resource.data.resourceType in ['image']
        )
        && request.resource.data.types is list
        && request.resource.data.types.size() > 0
        && (
          !request.resource.data.keys().hasAny(['deviceTypes'])
          || isValidDeviceTypes()
        )
        && request.resource.data.hashtags is list
        && request.resource.data.access in ['free', 'premium']
        && request.resource.data.visible is bool
        && (request.resource.data.width is int || request.resource.data.width is float)
        && (request.resource.data.height is int || request.resource.data.height is float)
        && request.resource.data.format is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    match /admins/{adminId} {
      allow get: if signedIn() && (request.auth.uid == adminId || isAdmin());
      allow list: if false;
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name', 'email', 'email_lower', 'mobile', 'role', 'createdAt'])
        && request.resource.data.role == 'member'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.email_lower is string
        && (
          !request.resource.data.keys().hasAny(['mobile'])
          || request.resource.data.mobile is string
        );

      allow update: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['name', 'email', 'email_lower', 'mobile', 'role', 'createdAt'])
          && request.resource.data.email == resource.data.email
          && request.resource.data.email_lower == resource.data.email_lower
          && (
            !request.resource.data.keys().hasAny(['mobile'])
            || request.resource.data.mobile is string
          )
          && request.resource.data.role == resource.data.role
        );

      allow delete: if isAdmin();

      match /savedWallpapers/{savedWallpaperId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly([
            'id',
            'title',
            'image',
            'url',
            'category',
            'savedAt'
          ])
          && request.resource.data.id == savedWallpaperId
          && request.resource.data.title is string
          && request.resource.data.image is string
          && request.resource.data.url is string
          && request.resource.data.category is string
          && request.resource.data.savedAt is timestamp;
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    match /wallpapers/{wallpaperId} {
      // Public pages use sanitized Cloud Functions responses. Original Cloudinary
      // delivery fields remain visible only to administrators.
      allow read: if isAdmin();
      allow create: if isAdmin()
        && isValidWallpaper()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isAdmin()
        && isValidWallpaper()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
